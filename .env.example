# ==========================================
# Server Configuration
# ==========================================
PORT=3001
HOST=0.0.0.0
ENV=development

# ==========================================
# Database Configuration (SQLite prototype)
# ==========================================
# By default, the backend uses an absolute path to `backend/database/sql_app.db`.
# Override only if you want a custom location:
# DATABASE_URL=sqlite:///C:/absolute/path/to/sql_app.db

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Admin
# ==========================================
ADMIN_EMAIL=admin@gmail.com

# ==========================================
# AI Sign Recognition
# ==========================================
# Defaults match the trainer outputs in `RSLdataset/saved_models/`.
# You can override these if you copy the model into `backend/`.
MODEL_PATH=../RSLdataset/saved_models/best_model.h5
CLASSES_PATH=../RSLdataset/saved_models/sign_classes.txt
SEQUENCE_LENGTH=90
# Optional: only used as a fallback when the model is not deployed yet.
FEATURE_SIZE=429
